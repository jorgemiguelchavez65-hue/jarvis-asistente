# Variables del servidor de Jarvis (en Render se configuran como variables de entorno, no en un archivo)
ANTHROPIC_API_KEY=
# Contraseña de la app del teléfono. Genera una con: jarvis token
JARVIS_ACCESS_TOKEN=
JARVIS_MODEL=claude-sonnet-5-5
# Voz a texto. "local" = Whisper en este equipo (extra "server"); "api" = servicio compatible con OpenAI
JARVIS_STT=local
JARVIS_WHISPER_MODEL=small          # solo con JARVIS_STT=local: tiny | base | small | medium
# JARVIS_STT=api
# JARVIS_STT_BASE_URL=https://api.groq.com/openai/v1
# JARVIS_STT_MODEL=whisper-large-v3-turbo
# JARVIS_STT_API_KEY=

# Datos. "local" = archivos en JARVIS_DATA_DIR; "postgres" = base externa (necesario en Render)
JARVIS_BACKEND=local
JARVIS_DATA_DIR=data
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# 1 = conservar el audio tras transcribir (por defecto se borra)
JARVIS_KEEP_AUDIO=0
JARVIS_MAX_AUDIO_MB=60
