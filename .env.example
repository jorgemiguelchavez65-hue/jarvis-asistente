# Variables del servidor de Jarvis (en la nube se configuran como "secrets", no en un archivo)
ANTHROPIC_API_KEY=
# Contraseña de la app del teléfono. Genera una con: jarvis token
JARVIS_ACCESS_TOKEN=
JARVIS_MODEL=claude-sonnet-5-5
# Modelo de voz a texto: tiny | base | small | medium (más grande = mejor y más lento)
JARVIS_WHISPER_MODEL=small
# Carpeta de datos (solo en modo local)
JARVIS_DATA_DIR=data

# Modo nube (lo configura scripts/deploy_firebase.sh; no hace falta tocarlo)
# JARVIS_BACKEND=gcp
# GOOGLE_CLOUD_PROJECT=  JARVIS_AUDIO_BUCKET=  JARVIS_TASKS_QUEUE=  JARVIS_TASKS_LOCATION=
# JARVIS_TASKS_SA=  JARVIS_SERVICE_URL=  JARVIS_TASKS_MAX_ATTEMPTS=5
# 1 = conservar el audio tras transcribir (por defecto se borra)
JARVIS_KEEP_AUDIO=0
JARVIS_MAX_AUDIO_MB=60
